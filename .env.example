# Source Database
SOURCE_DB_TYPE=mysql  # or postgresql
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=source_db
SOURCE_DB_USER=root
SOURCE_DB_PASSWORD=secret
SOURCE_DB_SSL_MODE=disable  # or require, verify-ca, verify-full

# Target Database
TARGET_DB_TYPE=mysql  # or postgresql
TARGET_DB_HOST=localhost
TARGET_DB_PORT=3306
TARGET_DB_NAME=target_db
TARGET_DB_USER=root
TARGET_DB_PASSWORD=secret
TARGET_DB_SSL_MODE=disable

# Migration Settings
BATCH_SIZE=1000
MAX_WORKERS=4
ENABLE_VALIDATION=true
CONFLICT_STRATEGY=fail  # fail, overwrite, skip, merge
LOG_LEVEL=INFO
